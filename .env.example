# FIR Sahayak — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

APP_NAME=FIR-Sahayak
APP_ENV=development

# JWT — Change SECRET_KEY before any non-demo use
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (SQLite — update path to match your machine)
DATABASE_URL=sqlite+aiosqlite:///C:/path/to/FIR-Sahayak/data/fir_sahayak.db
SYNC_DATABASE_URL=sqlite:///C:/path/to/FIR-Sahayak/data/fir_sahayak.db

# Storage paths (update to match your machine)
EVIDENCE_DIR=C:/path/to/FIR-Sahayak/data/evidence
EXPORTS_DIR=C:/path/to/FIR-Sahayak/data/exports
BACKUPS_DIR=C:/path/to/FIR-Sahayak/data/backups

# Google Gemini API
# Get your key from: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_TEXT_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Demo Mode
DEMO_MODE=true
ALLOW_SYNTHETIC_DATA=true
