# ==============================================================================
# FIR SAHAYAK — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control or public repositories.
# ==============================================================================

APP_NAME=FIR-Sahayak
APP_ENV=development

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_FOR_PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# Primary Cloud Backend: Supabase PostgreSQL & Private Storage
# ------------------------------------------------------------------------------
# Replace with your Supabase Project details:
# 1. Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co
# 2. Supabase Anon Public Key
SUPABASE_KEY=your-supabase-anon-key-here
# 3. Supabase Service Role Key (Required for private bucket upload & backend administrative operations)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
# 4. Supabase Storage Bucket Name (Default: evidence)
SUPABASE_STORAGE_BUCKET=evidence
# 5. Supabase PostgreSQL Connection String (Transaction Pooler or Direct Connection)
# Example: postgresql+asyncpg://postgres.xyz:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
SUPABASE_DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.your-project.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# Local Offline Mode / Isolated Test Fallback
# ------------------------------------------------------------------------------
# If SUPABASE_DATABASE_URL is not set, FIR Sahayak automatically operates in
# local SQLite mode.
DATABASE_URL=sqlite+aiosqlite:///C:/Users/LENOVO/Desktop/FIR-Sahayak/data/fir_sahayak.db
SYNC_DATABASE_URL=sqlite:///C:/Users/LENOVO/Desktop/FIR-Sahayak/data/fir_sahayak.db

# ------------------------------------------------------------------------------
# Storage Directory Paths
# ------------------------------------------------------------------------------
EVIDENCE_DIR=C:/Users/LENOVO/Desktop/FIR-Sahayak/data/evidence
EXPORTS_DIR=C:/Users/LENOVO/Desktop/FIR-Sahayak/data/exports
BACKUPS_DIR=C:/Users/LENOVO/Desktop/FIR-Sahayak/data/backups

# ------------------------------------------------------------------------------
# Google Gemini AI Integration (Required for Grounded RAG & Field Extraction)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ------------------------------------------------------------------------------
# Sarvam AI Document Intelligence API (Official Digitise & Extract)
# ------------------------------------------------------------------------------
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_BASE_URL=https://api.sarvam.ai

# ------------------------------------------------------------------------------
# Demo & Synthetic Data Settings
# ------------------------------------------------------------------------------
DEMO_MODE=true
ALLOW_SYNTHETIC_DATA=true
